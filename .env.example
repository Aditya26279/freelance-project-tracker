# SQLite for local use. For production switch provider to "postgresql" in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Used to sign sessions and encrypt payment keys stored in the DB. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="change-me-to-a-long-random-string"

# Public base URL (used for portal links and payment redirects)
APP_URL="http://localhost:3000"

# Optional: set to "false" to disable public sign-ups (single-freelancer mode)
ALLOW_SIGNUP="true"
